# ============================================================
# RAG-study 环境变量示例（仓库根目录）
# 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 忽略。
#   cp .env.example .env
# 该文件同时被 docker-compose 与 Java 引擎（spring.config.import）读取，
# 也是 Python 与 Java 共享 JWT 密钥的唯一事实源。
# ============================================================

# ---------- 数据库 / 缓存 / 向量库 ----------
# 必填：未设置时 docker compose 会直接报错退出，不再回落到弱口令
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=rag_engine
MYSQL_PORT=3306
REDIS_PORT=6379
# Qdrant：6333=REST，6334=gRPC（Java 客户端走 gRPC）
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------- 服务端口 ----------
PYTHON_PORT=8001
JAVA_PORT=8002
FRONTEND_PORT=80

# ---------- Java 引擎直连 MySQL ----------
DB_USERNAME=root
DB_PASSWORD=change-me-strong-password

# ---------- 认证 ----------
# 必填。必须与 backend/.env 的 JWT_SECRET_KEY 使用同一值，否则 Java 签发的
# 令牌无法在 Python 侧校验。长度至少 32 字符。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-48-char-secret

# ---------- 服务间接口令牌 ----------
# 必填。Java 的 /api/internal/** 由该令牌门禁，Python 与 MCP 服务需携带
# 同名 X-Internal-Token 请求头。未配置时 Java 启动失败（fail closed）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=replace-with-a-random-token

# ---------- 大模型（OpenAI 兼容端点） ----------
# 【数据流向，交付前请与客户确认】
#   发送到该端点的内容：用户提问 + 检索到的制度原文片段 + 最近几轮对话历史。
#   不发送：整库文档、向量库、用户凭证。
#   因此若客户制度含薪酬/人事/涉密内容，或客户有"数据不得出内网"的硬性要求，
#   必须换成客户内网的私有模型（见下方"换模型"）。
#
# 换模型只需改这三行，无需改代码（任何 OpenAI 兼容服务均可）：
#   vLLM        LLM_BASE_URL=http://10.0.0.21:8000/v1    LLM_MODEL=qwen2.5-7b-instruct
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b
#   国产云 API  填写其 OpenAI 兼容模式地址
# base_url 结尾带不带 /v1 都兼容。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-replace-with-your-key
LLM_MODEL=deepseek-chat

# 换模型后请先做能力探测（基础对话/流式/工具调用三项）：
#   python deploy/check-llm.py
# 若探测结果显示"工具调用不可用"，需在 .env 中设 ENABLE_AGENT_MODE=false，
# 否则 Agent 模式会失败（制度问答主链路不受影响）。
#
# 历史变量名（DEEPSEEK_*）仍兼容，两者填其一即可；同时存在时以 LLM_* 优先。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# ---------- CORS 允许来源 ----------
# 逗号分隔。不要使用 *：与 allow_credentials=True 组合既不合法也不安全。
# 生产环境改为真实域名，例如 https://rag.example.com
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001

# ---------- 访客问答 ----------
# 访客的基础检索范围由服务端强制为"公共级(PUBLIC)"知识库，本项为可选的附加限制。
# 留空 = 访客可检索全部公共级知识库；
# 配置（逗号分隔 kb_id）= 与公共级取交集，进一步收窄；交集为空则访客退化为闲聊。
GUEST_KB_IDS=

# ---------- 对话限流 ----------
# 仅作用于 /api/chat、/api/chat/guest、/api/agent/chat（LLM 烧钱路径）。
# 登录用户按 user_id 计数，访客按 client IP 计数；Redis 不可用时放行并记日志。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_GUEST_PER_MIN=5

# ---------- 敏感词检查 ----------
# 对话（含访客）在检索前调用 Java 敏感词服务（/api/internal/security/sensitive-check），
# 命中即拒绝回答。Java 不可达时放行并记日志（fail open）。
ENABLE_SENSITIVE_WORD_CHECK=true

# ---------- Self-RAG 运行模式 ----------
# off        —— 不做验证（最低延迟）
# log        —— 后台验证仅记日志，不阻塞响应
# corrective —— 验证不充分时同步补充检索并重新生成（默认，最多增加 8s 延迟）
SELF_RAG_MODE=corrective

# ---------- Agent http_request 工具出站控制 ----------
# 允许访问的主机白名单，逗号分隔，支持 *.example.com 通配。
# 留空 = 完全禁用该工具的出站请求（默认 fail closed）。
HTTP_TOOL_ALLOWED_HOSTS=
# 是否允许访问内网/回环地址。默认 false，防止 SSRF 探测内网。
HTTP_TOOL_ALLOW_PRIVATE=false

# ---------- 后端镜像构建开关 ----------
# 是否把可选的本地降级检索依赖（chromadb + sentence-transformers/torch）
# 装进后端镜像。默认 false：容器部署下该路径不可用（模型未预置），
# 且会让镜像膨胀约 900MB（Linux 含 CUDA 相关包时更多）。
# 仅当不部署 Java 引擎、要让 Python 直接用本地 ChromaDB 检索时才设为 true。
INSTALL_FALLBACK=false
