# ============================================================
# RAG-study Python 编排层环境变量示例（backend/.env）
# 用法：复制为 backend/.env 后填入真实值。
# 优先级：真实环境变量 > 仓库根 .env > backend/.env
#   （见 backend/config.py 的加载顺序说明）
# JWT_SECRET_KEY 与 INTERNAL_API_TOKEN 必须与仓库根 .env 保持一致。
# ============================================================

# ---------- 大模型 ----------
DEEPSEEK_API_KEY=sk-replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- MySQL（用户账号） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=rag_engine

# ---------- Redis（会话存储，未启动时自动降级 SQLite） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- 认证 ----------
# 必须与仓库根 .env 的 JWT_SECRET 完全一致，至少 32 字符
JWT_SECRET_KEY=replace-with-the-same-value-as-root-JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 服务 ----------
HOST=localhost
PORT=8001
JAVA_BACKEND_URL=http://localhost:8002

# ---------- 服务间接口令牌（与根 .env 的 INTERNAL_API_TOKEN 一致） ----------
INTERNAL_API_TOKEN=replace-with-the-same-value-as-root-INTERNAL_API_TOKEN

# ---------- CORS 允许来源（逗号分隔，不要使用 *） ----------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001

# ---------- Agent http_request 工具出站控制 ----------
# 留空 = 禁用该工具出站请求；需要调用内部系统时设 HTTP_TOOL_ALLOW_PRIVATE=true
HTTP_TOOL_ALLOWED_HOSTS=
HTTP_TOOL_ALLOW_PRIVATE=false

# ---------- Embedding / 检索（不设置则使用代码内默认值） ----------
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
TOP_K=5
SIMILARITY_THRESHOLD=0.3
USE_HYBRID_SEARCH=true
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
